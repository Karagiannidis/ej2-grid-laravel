{
    "name": "karagiannidis/ej2-grid-laravel",
    "description": "Server-side data source adaptor for EJ2 Grid in Laravel",
    "type": "library",
    "keywords": [
        "Ej2",
        "Grid",
        "Laravel",
        "Tables"
    ],
    "homepage": "https://github.com/Karagiannidis/ej2-grid-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Karagiannidis Petros",
            "email": "hello@petros.codes",
            "homepage": "https://petros.codes",
            "role": "Developer"
        }
    ],
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse"
    },
    "autoload": {
        "psr-4": {
            "Karagiannidis\\Ej2Grid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karagiannidis\\Ej2Grid\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karagiannidis\\Ej2Grid\\PackageServiceProvider"
            ],
            "aliases": {
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
