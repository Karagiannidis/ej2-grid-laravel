{
    "name": "karagiannidis/ej2-grid-laravel",
    "description": "Server-side data source adaptor for EJ2 Grid in Laravel",
    "type": "library",
    "keywords": [
        "Ej2",
        "Grid",
        "Laravel",
        "Tables"
    ],
    "homepage": "https://github.com/Karagiannidis/ej2-grid-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Karagiannidis Petros",
            "email": "hello@petros.codes",
            "homepage": "https://petros.codes",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.4"
    },
    "scripts": {
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse",
        "test": "pest",
        "test:mysql": [
            "docker compose up -d --wait mysql",
            "@putenv DB_CONNECTION=mysql",
            "@putenv DB_PORT=33306",
            "pest"
        ],
        "test:pgsql": [
            "docker compose up -d --wait pgsql",
            "@putenv DB_CONNECTION=pgsql",
            "@putenv DB_PORT=55432",
            "pest"
        ],
        "test:databases": [
            "@test",
            "@test:mysql",
            "@test:pgsql"
        ],
        "databases:stop": "docker compose down",
        "test:coverage": "pest --coverage --min=100",
        "test:types": "pest --type-coverage --min=100",
        "check": [
            "@refactor:check",
            "@lint:check",
            "@analyse",
            "@test:coverage",
            "@test:types"
        ]
    },
    "autoload": {
        "psr-4": {
            "Karagiannidis\\Ej2Grid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karagiannidis\\Ej2Grid\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karagiannidis\\Ej2Grid\\PackageServiceProvider"
            ],
            "aliases": {
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
